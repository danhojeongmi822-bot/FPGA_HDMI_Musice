# HX4S20 HDL2410 / EG4S20BG256 / HDMI connector A
# LVDS33 matches vendor lab_ex_6_tf_sdram_hdmi/top.adc.
# TD automatically pairs TMDS negative pins: J1,F4,E4,D3.
# Physical KEY1=reset, KEY2=next image, KEY3=auto play.
set_pin_assignment { clk } { LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { rst_n } { LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key1 } { LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { key2 } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_CLK_P } { LOCATION = K1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D0_P } { LOCATION = F5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D1_P } { LOCATION = E3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_D2_P } { LOCATION = B3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sd_ncs } { LOCATION = A12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { sd_dclk } { LOCATION = A14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { sd_mosi } { LOCATION = A13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { sd_miso } { LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { seg_sel[0] } { LOCATION = F16; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[1] } { LOCATION = E16; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[2] } { LOCATION = E12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[3] } { LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[4] } { LOCATION = C13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[5] } { LOCATION = F10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[6] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_sel[7] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[0] } { LOCATION = C15; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[1] } { LOCATION = C16; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[2] } { LOCATION = B6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[3] } { LOCATION = A5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[4] } { LOCATION = B5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[5] } { LOCATION = A8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[6] } { LOCATION = A7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
set_pin_assignment { seg_data[7] } { LOCATION = A6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; DRIVESTRENGTH = 8; }
